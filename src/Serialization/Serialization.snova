package Snova.Std.Serialization

import Snova.Std.Strings
import Snova.Std.Collections

/* -- Doc:{SerializationError}
 *
 * -- Description: Structured error types for parsing and serialization failures.
 */
enum SerializationError {
    SyntaxError(message: string, line: int)
    InvalidData(reason: string)
    TypeMismatch(expected: string, found: string)
}

public struct DataEntry {
    public var key: string
    public var value: DataNode

    public static method new(key: string, value: DataNode): DataEntry {
        return DataEntry(key, value)
    }
}

enum DataNode {
    Null
    Bool(value: bool)
    IntNumber(value: int)
    FloatNumber(value: double)
    Text(value: string)
    List(items: Array<DataNode>)
    Dict(entries: Array<DataEntry>)
}

public class JsonSerializer {
    public static method escapeString(s: string): string {
        var out = "\""
        var i = 0
        while i < s.len() {
            let c = s.substring(i, i + 1)
            if c == "\"" {
                out = out + "\\\""
            } else if c == "\\" {
                out = out + "\\\\"
            } else if c == "\n" {
                out = out + "\\n"
            } else if c == "\r" {
                out = out + "\\r"
            } else if c == "\t" {
                out = out + "\\t"
            } else {
                out = out + c
            }
            i = i + 1
        }
        out = out + "\""
        return out
    }

    public static method stringify(node: DataNode): string {
        match node {
            DataNode.Null -> { return "null" }
            DataNode.Bool(b) -> {
                if b { return "true" }
                return "false"
            }
            DataNode.IntNumber(n) -> { return StringUtils.intToString(n) }
            DataNode.FloatNumber(d) -> { return "0.0" }
            DataNode.Text(s) -> { return JsonSerializer.escapeString(s) }
            DataNode.List(items) -> {
                var out = "["
                var i = 0
                while i < items.len() {
                    out = out + JsonSerializer.stringify(items[i])
                    if i + 1 < items.len() {
                        out = out + ","
                    }
                    i = i + 1
                }
                out = out + "]"
                return out
            }
            DataNode.Dict(entries) -> {
                var out = "{"
                var i = 0
                while i < entries.len() {
                    let k = JsonSerializer.escapeString(entries[i].key)
                    let v = JsonSerializer.stringify(entries[i].value)
                    out = out + k + ":" + v
                    if i + 1 < entries.len() {
                        out = out + ","
                    }
                    i = i + 1
                }
                out = out + "}"
                return out
            }
            _ -> { return "null" }
        }
        return "null"
    }
}

public class JsonParser {
    public static method parse(jsonText: string): Result<DataNode, SerializationError> {
        let trimmed = jsonText.trim()
        if trimmed == "null" { return Ok(DataNode.Null) }
        if trimmed == "true" { return Ok(DataNode.Bool(true)) }
        if trimmed == "false" { return Ok(DataNode.Bool(false)) }

        if trimmed.startsWith("\"") && trimmed.endsWith("\"") {
            let inner = JsonParser.extractStringContent(trimmed)
            return Ok(DataNode.Text(inner))
        }

        let numOpt = StringUtils.parseInt(trimmed)
        match numOpt {
            Some(n) -> {
                return Ok(DataNode.IntNumber(n))
            }
            None -> {}
        }

        if trimmed.startsWith("[") && trimmed.endsWith("]") {
            let listItems: Array<DataNode> = []
            return Ok(DataNode.List(listItems))
        }

        if trimmed.startsWith("{") && trimmed.endsWith("}") {
            let dictEntries: Array<DataEntry> = []
            return Ok(DataNode.Dict(dictEntries))
        }

        return Err(SerializationError.SyntaxError("Invalid JSON input", 0))
    }

    private static method extractStringContent(quotedText: string): string {
        var content = ""
        if quotedText.len() >= 2 {
            content = quotedText.substring(1, quotedText.len() - 1)
        }
        return content
    }
}
