package Snova.Std.Async

import Snova.Std.Collections

/* -- Doc:{TaskStatus}
 *
 * -- Description: Lifecycle state of an asynchronous future or task.
 */
enum TaskStatus {
    Pending
    Running
    Completed
    Failed
    Cancelled
}

/* -- Doc:{Channel}
 *
 * -- Description: Multi-producer, multi-consumer concurrency communication primitive.
 */
public class Channel<T> {
    private var buffer: Array<T>
    private var isClosed: bool

    public static method new(): Channel<T> {
        let empty: Array<T> = []
        return Channel<T>(empty, false)
    }

    public method send(message: T): bool {
        if this.isClosed {
            return false
        }
        this.buffer.push(message)
        return true
    }

    public method receive(): Option<T> {
        if this.buffer.len() == 0 {
            return None
        }
        let item = this.buffer[0]
        var i = 0
        while i < this.buffer.len() - 1 {
            this.buffer[i] = this.buffer[i + 1]
            i = i + 1
        }
        this.buffer.pop()
        return Some(item)
    }

    public method close(): int {
        this.isClosed = true
        return 0
    }

    public method len(): int {
        return this.buffer.len()
    }

    public method closed(): bool {
        return this.isClosed
    }
}
