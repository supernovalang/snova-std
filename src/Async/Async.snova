package Snova.Std.Async

/* -- Doc:{TaskState}
 *
 * -- Description: Lifecycle states of asynchronous tasks and promises.
 */
enum TaskState {
    Pending
    Running
    Completed
    Failed(reason: string)
    Cancelled
}

/* -- Doc:{Channel}
 *
 * -- Description: Multi-producer lightweight concurrent communication channel.
 */
public class Channel {
    private var buffer: Array<string>
    private var isClosed: bool

    /* -- Doc:{new}
     *
     * -- Description: Creates a new open concurrent Channel.
     *
     * -- Returns: Channel instance.
     */
    public static method new(): Channel {
        let ch = Channel()
        ch.buffer = []
        ch.isClosed = false
        return ch
    }

    /* -- Doc:{send}
     *
     * -- Description: Sends a message string into the channel.
     *
     * -- Param{message}: Content to send.
     * -- Returns: True if sent successfully, false if closed.
     */
    public method send(message: string): bool {
        if this.isClosed {
            return false
        }
        this.buffer.push(message)
        return true
    }

    /* -- Doc:{receive}
     *
     * -- Description: Receives next available message from the channel.
     *
     * -- Returns: Option with message or None if channel buffer is empty.
     */
    public method receive(): Option<string> {
        if this.buffer.len() == 0 {
            return None
        }
        let msg = this.buffer[0]
        let newBuf: Array<string> = []
        var i = 1
        while i < this.buffer.len() {
            newBuf.push(this.buffer[i])
            i = i + 1
        }
        this.buffer = newBuf
        return Some(msg)
    }

    /* -- Doc:{close}
     *
     * -- Description: Closes the channel and disallows further send operations.
     *
     * -- Returns: True.
     */
    public method close(): bool {
        this.isClosed = true
        return true
    }

    /* -- Doc:{len}
     *
     * -- Description: Returns number of pending messages in channel.
     *
     * -- Returns: Count.
     */
    public method len(): int {
        return this.buffer.len()
    }
}
