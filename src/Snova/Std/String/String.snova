package Snova.Std.String

class StringBuilder {
    var content: string

    static method new(): StringBuilder {
        let sb = StringBuilder()
        sb.content = ""
        return sb
    }

    method append(s: string): StringBuilder {
        this.content = this.content + s
        return this
    }

    method appendLine(s: string): StringBuilder {
        this.content = this.content + s + "\n"
        return this
    }

    method toString(): string {
        return this.content
    }

    method length(): int {
        return this.content.len()
    }

    method clear(): unit {
        this.content = ""
    }
}

class StringUtils {
    static method concat(a: string, b: string): string {
        return a + b
    }

    static method isNotEmpty(s: string): bool {
        return s.len() > 0
    }

    static method isEmpty(s: string): bool {
        return s.len() == 0
    }
}
