package Snova.Std.Network.Http

// Native Core: única camada que toca o SO e usa @Native()
@Native()
class Socket {
    @Native()
    static method listen(host: string, port: int): int

    @Native()
    static method accept(serverFd: int): int

    @Native()
    static method receive(fd: int, maxLen: int): string

    @Native()
    static method send(fd: int, data: string): int

    @Native()
    static method close(fd: int): unit
}

// Representação de Requisição HTTP (100% Snova puro)
class HttpRequest {
    var method: string
    var path: string
    var query: string
    var body: string

    static method new(method: string, path: string, body: string): HttpRequest {
        let req = HttpRequest()
        req.method = method
        req.path = path
        req.query = ""
        req.body = body
        return req
    }

    method getMethod(): string {
        return this.method
    }

    method getPath(): string {
        return this.path
    }

    method getBody(): string {
        return this.body
    }
}

// Representação de Resposta HTTP (100% Snova puro)
class HttpResponse {
    var statusCode: int
    var contentType: string
    var body: string

    static method new(): HttpResponse {
        let r = HttpResponse()
        r.statusCode = 200
        r.contentType = "text/plain"
        r.body = ""
        return r
    }

    method status(code: int): HttpResponse {
        this.statusCode = code
        return this
    }

    method send(text: string): HttpResponse {
        this.body = text
        return this
    }

    method json(text: string): HttpResponse {
        this.contentType = "application/json"
        this.body = text
        return this
    }

    method toHttpString(): string {
        let statusMsg = "OK"
        if this.statusCode == 404 {
            statusMsg = "Not Found"
        } else if this.statusCode == 500 {
            statusMsg = "Internal Server Error"
        } else if this.statusCode == 201 {
            statusMsg = "Created"
        }

        let resp = "HTTP/1.1 " + this.statusCode + " " + statusMsg + "\r\n"
        resp = resp + "Content-Type: " + this.contentType + "\r\n"
        resp = resp + "Content-Length: " + this.body.len() + "\r\n"
        resp = resp + "Connection: close\r\n\r\n"
        resp = resp + this.body
        return resp
    }
}

// Rota HTTP (100% Snova puro)
class HttpRoute {
    var method: string
    var path: string
    var handler: any

    static method new(method: string, path: string, handler: any): HttpRoute {
        let r = HttpRoute()
        r.method = method
        r.path = path
        r.handler = handler
        return r
    }
}

// Servidor HTTP (100% Snova puro)
class HttpServer {
    var host: string
    var port: int
    var routes: Array<HttpRoute>

    static method new(): HttpServer {
        let s = HttpServer()
        s.host = "0.0.0.0"
        s.port = 8080
        s.routes = Array<HttpRoute>.new()
        return s
    }

    method get(path: string, handler: any): HttpServer {
        this.routes.push(HttpRoute.new("GET", path, handler))
        return this
    }

    method post(path: string, handler: any): HttpServer {
        this.routes.push(HttpRoute.new("POST", path, handler))
        return this
    }

    method route(methodName: string, path: string, handler: any): HttpServer {
        this.routes.push(HttpRoute.new(methodName, path, handler))
        return this
    }

    method parseRequest(raw: string): HttpRequest {
        let method = "GET"
        let path = "/"
        let body = ""

        if raw.len() > 0 {
            let firstLineEnd = raw.indexOf("\r\n")
            if firstLineEnd > 0 {
                let firstLine = raw.substring(0, firstLineEnd)
                let firstSpace = firstLine.indexOf(" ")
                if firstSpace > 0 {
                    method = firstLine.substring(0, firstSpace)
                    let remaining = firstLine.substring(firstSpace + 1, firstLine.len())
                    let secondSpace = remaining.indexOf(" ")
                    if secondSpace > 0 {
                        path = remaining.substring(0, secondSpace)
                    } else {
                        path = remaining
                    }
                }
            }

            let bodyStart = raw.indexOf("\r\n\r\n")
            if bodyStart >= 0 {
                body = raw.substring(bodyStart + 4, raw.len())
            }
        }

        return HttpRequest.new(method, path, body)
    }

    method listen(port: int): int {
        this.port = port
        let serverFd = Socket.listen(this.host, this.port)
        if serverFd < 0 {
            Console.printline("[HttpServer] Erro ao iniciar socket na porta " + this.port)
            return -1
        }

        Console.printline("[HttpServer] Servidor escutando em http://127.0.0.1:" + this.port)

        var running = true
        while running {
            let clientFd = Socket.accept(serverFd)
            if clientFd >= 0 {
                let rawReq = Socket.receive(clientFd, 4096)
                let req = this.parseRequest(rawReq)
                let res = HttpResponse.new()

                var matched = false
                var i = 0
                while i < this.routes.len() {
                    let r = this.routes.get(i)
                    if (r.method == req.method || r.method == "*") && (r.path == req.path || r.path == "*") {
                        let fn = r.handler
                        fn(req, res)
                        matched = true
                        i = this.routes.len()
                    }
                    i = i + 1
                }

                if !matched {
                    res.status(404).send("404 Not Found")
                }

                Socket.send(clientFd, res.toHttpString())
                Socket.close(clientFd)
            }
        }

        Socket.close(serverFd)
        return 0
    }
}
