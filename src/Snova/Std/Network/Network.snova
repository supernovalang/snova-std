package Snova.Std.Network

import Snova.Std.IO

// Native Core: Única fronteira com o Sistema Operacional
@Native()
class Socket {
    @Native()
    static method listen(host: string, port: int): int

    @Native()
    static method accept(serverFd: int): int

    @Native()
    static method receive(fd: int, maxLen: int): string

    @Native()
    static method send(fd: int, data: string): int

    @Native()
    static method close(fd: int): unit
}

// Abstração de Socket TCP em Snova puro, implementando Stream
class TcpSocket : Stream {
    var rawHandle: int
    var isClosed: bool

    static method fromHandle(handle: int): TcpSocket {
        let s = TcpSocket()
        s.rawHandle = handle
        s.isClosed = false
        return s
    }

    method read(maxLen: int): string {
        if this.isClosed {
            return ""
        }
        return Socket.receive(this.rawHandle, maxLen)
    }

    method write(data: string): int {
        if this.isClosed {
            return 0
        }
        return Socket.send(this.rawHandle, data)
    }

    method close(): unit {
        if !this.isClosed {
            Socket.close(this.rawHandle)
            this.isClosed = true
        }
    }
}

// Listener TCP em Snova puro
class TcpListener : Closer {
    var rawHandle: int
    var host: string
    var port: int
    var isClosed: bool

    static method bind(host: string, port: int): TcpListener {
        let l = TcpListener()
        l.host = host
        l.port = port
        l.rawHandle = Socket.listen(host, port)
        l.isClosed = l.rawHandle < 0
        return l
    }

    method isValid(): bool {
        return this.rawHandle >= 0 && !this.isClosed
    }

    method accept(): TcpSocket {
        if this.isClosed || this.rawHandle < 0 {
            return TcpSocket.fromHandle(-1)
        }
        let clientFd = Socket.accept(this.rawHandle)
        return TcpSocket.fromHandle(clientFd)
    }

    method close(): unit {
        if !this.isClosed {
            Socket.close(this.rawHandle)
            this.isClosed = true
        }
    }
}

// Ponto de entrada fluente da rede
class Tcp {
    static method listen(address: string, port: int): TcpListener {
        return TcpListener.bind(address, port)
    }
}
