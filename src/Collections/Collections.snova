package Snova.Std.Collections

/* -- Doc:{List}
 *
 * -- Description: Dynamic resizable array list collection implemented in pure Snovalang.
 */
public class List<T> {
    private var items: Array<T>

    public static method new(): List<T> {
        let empty: Array<T> = []
        return List<T>(empty)
    }

    public method add(item: T): int {
        this.items.push(item)
        return this.items.len()
    }

    public method get(index: int): Option<T> {
        if index < 0 || index >= this.items.len() {
            return None
        }
        return Some(this.items[index])
    }

    public method set(index: int, item: T): bool {
        if index < 0 || index >= this.items.len() {
            return false
        }
        this.items[index] = item
        return true
    }

    public method removeAt(index: int): Option<T> {
        if index < 0 || index >= this.items.len() {
            return None
        }
        let item = this.items[index]
        var newItems: Array<T> = []
        var i = 0
        let total = this.items.len()
        while i < total {
            if i != index {
                newItems.push(this.items[i])
            }
            i = i + 1
        }
        this.items = newItems
        return Some(item)
    }

    public method pop(): Option<T> {
        if this.items.len() == 0 {
            return None
        }
        let lastIdx = this.items.len() - 1
        let item = this.items[lastIdx]
        var newItems: Array<T> = []
        var i = 0
        while i < lastIdx {
            newItems.push(this.items[i])
            i = i + 1
        }
        this.items = newItems
        return Some(item)
    }

    public method len(): int {
        return this.items.len()
    }

    public method isEmpty(): bool {
        return this.items.len() == 0
    }

    public method clear(): int {
        let empty: Array<T> = []
        this.items = empty
        return 0
    }

    public method all(): Array<T> {
        return this.items
    }
}

public struct MapEntry<K, V> {
    public var key: K
    public var value: V

    public static method new(key: K, value: V): MapEntry<K, V> {
        return MapEntry<K, V>(key, value)
    }
}

public class Map<K, V> {
    private var entries: Array<MapEntry<K, V>>

    public static method new(): Map<K, V> {
        let empty: Array<MapEntry<K, V>> = []
        return Map<K, V>(empty)
    }

    public method put(key: K, value: V): int {
        var i = 0
        let total = this.entries.len()
        while i < total {
            if this.entries[i].key == key {
                this.entries[i] = MapEntry.new(key, value)
                return 0
            }
            i = i + 1
        }
        this.entries.push(MapEntry.new(key, value))
        return 0
    }

    public method get(key: K): Option<V> {
        var i = 0
        let total = this.entries.len()
        while i < total {
            if this.entries[i].key == key {
                return Some(this.entries[i].value)
            }
            i = i + 1
        }
        return None
    }

    public method has(key: K): bool {
        var i = 0
        let total = this.entries.len()
        while i < total {
            if this.entries[i].key == key {
                return true
            }
            i = i + 1
        }
        return false
    }

    public method len(): int {
        return this.entries.len()
    }

    public method isEmpty(): bool {
        return this.entries.len() == 0
    }

    public method clear(): int {
        let empty: Array<MapEntry<K, V>> = []
        this.entries = empty
        return 0
    }

    public method all(): Array<MapEntry<K, V>> {
        return this.entries
    }
}

public class Set<T> {
    private var elements: Array<T>

    public static method new(): Set<T> {
        let empty: Array<T> = []
        return Set<T>(empty)
    }

    public method add(element: T): bool {
        if this.contains(element) {
            return false
        }
        this.elements.push(element)
        return true
    }

    public method contains(element: T): bool {
        var i = 0
        let total = this.elements.len()
        while i < total {
            if this.elements[i] == element {
                return true
            }
            i = i + 1
        }
        return false
    }

    public method len(): int {
        return this.elements.len()
    }

    public method isEmpty(): bool {
        return this.elements.len() == 0
    }

    public method clear(): int {
        let empty: Array<T> = []
        this.elements = empty
        return 0
    }

    public method all(): Array<T> {
        return this.elements
    }
}

public class Queue<T> {
    private var items: Array<T>
    private var head: int

    public static method new(): Queue<T> {
        let empty: Array<T> = []
        return Queue<T>(empty, 0)
    }

    public method enqueue(item: T): int {
        this.items.push(item)
        return this.len()
    }

    public method dequeue(): Option<T> {
        if this.head >= this.items.len() {
            return None
        }
        let item = this.items[this.head]
        this.head = this.head + 1
        return Some(item)
    }

    public method len(): int {
        return this.items.len() - this.head
    }

    public method isEmpty(): bool {
        return this.len() == 0
    }

    public method clear(): int {
        let empty: Array<T> = []
        this.items = empty
        this.head = 0
        return 0
    }
}
