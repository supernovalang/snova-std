package Snova.Std.Http

import Snova.Std.IO
import Snova.Std.Strings
import Snova.Std.Collections

/* -- Doc:{HttpMethod}
 *
 * -- Description: Standard HTTP protocol request methods.
 */
enum HttpMethod {
    Get
    Post
    Put
    Delete
    Patch
    Head
    Options
}

/* -- Doc:{HttpStatusHelper}
 *
 * -- Description: Helper providing HTTP status code descriptions and method serialization.
 */
public class HttpStatusHelper {
    public static method reasonPhrase(code: int): string {
        if code == 200 { return "OK" }
        if code == 201 { return "Created" }
        if code == 204 { return "No Content" }
        if code == 301 { return "Moved Permanently" }
        if code == 302 { return "Found" }
        if code == 400 { return "Bad Request" }
        if code == 401 { return "Unauthorized" }
        if code == 403 { return "Forbidden" }
        if code == 404 { return "Not Found" }
        if code == 405 { return "Method Not Allowed" }
        if code == 500 { return "Internal Server Error" }
        if code == 502 { return "Bad Gateway" }
        if code == 503 { return "Service Unavailable" }
        return "Unknown Status"
    }

    public static method methodToString(method: HttpMethod): string {
        match method {
            HttpMethod.Get -> { return "GET" }
            HttpMethod.Post -> { return "POST" }
            HttpMethod.Put -> { return "PUT" }
            HttpMethod.Delete -> { return "DELETE" }
            HttpMethod.Patch -> { return "PATCH" }
            HttpMethod.Head -> { return "HEAD" }
            HttpMethod.Options -> { return "OPTIONS" }
            _ -> { return "GET" }
        }
        return "GET"
    }
}

/* -- Doc:{HttpHeader}
 *
 * -- Description: An individual HTTP header key-value pair.
 */
public struct HttpHeader {
    public var name: string
    public var value: string

    public static method new(name: string, value: string): HttpHeader {
        return HttpHeader(name, value)
    }
}

/* -- Doc:{HeaderMap}
 *
 * -- Description: Collection of HTTP headers with case-preserving lookup and replacement.
 */
public class HeaderMap {
    private var entries: Array<HttpHeader>

    public static method new(): HeaderMap {
        let empty: Array<HttpHeader> = []
        return HeaderMap(empty)
    }

    public method set(name: string, value: string): int {
        var i = 0
        while i < this.entries.len() {
            if this.entries[i].name == name {
                this.entries[i] = HttpHeader.new(name, value)
                return 0
            }
            i = i + 1
        }
        this.entries.push(HttpHeader.new(name, value))
        return 0
    }

    public method get(name: string): Option<string> {
        var i = 0
        while i < this.entries.len() {
            if this.entries[i].name == name {
                return Some(this.entries[i].value)
            }
            i = i + 1
        }
        return None
    }

    public method all(): Array<HttpHeader> {
        return this.entries
    }
}

/* -- Doc:{HttpRequest}
 *
 * -- Description: Client or server HTTP request representation.
 */
public class HttpRequest {
    public var method: HttpMethod
    public var path: string
    public var headers: HeaderMap
    public var body: string

    public static method new(method: HttpMethod, path: string, headers: HeaderMap, body: string): HttpRequest {
        return HttpRequest(method, path, headers, body)
    }

    public method format(): string {
        let methodStr = HttpStatusHelper.methodToString(this.method)
        var out = methodStr + " " + this.path + " HTTP/1.1\r\n"
        let allHeaders = this.headers.all()
        var i = 0
        while i < allHeaders.len() {
            out = out + allHeaders[i].name + ": " + allHeaders[i].value + "\r\n"
            i = i + 1
        }
        out = out + "\r\n" + this.body
        return out
    }
}

/* -- Doc:{HttpResponse}
 *
 * -- Description: HTTP response packet model with generic typed payload and optional native serialization.
 */
public class HttpResponse<T> {
    public var statusCode: int
    public var headers: HeaderMap
    public var body: string
    public var data: T

    public static method new(statusCode: int, headers: HeaderMap, body: string, data: T): HttpResponse<T> {
        return HttpResponse<T>(statusCode, headers, body, data)
    }

    /* -- Doc:{ok}
     *
     * -- Description: Creates a 200 OK generic HttpResponse holding typed data.
     */
    public static method ok(data: T, bodyJson: string = ""): HttpResponse<T> {
        let headers = HeaderMap.new()
        headers.set("Content-Type", "application/json; charset=utf-8")
        headers.set("Content-Length", StringUtils.intToString(bodyJson.len()))
        return HttpResponse<T>(200, headers, bodyJson, data)
    }

    /* -- Doc:{json}
     *
     * -- Description: Creates an application/json HttpResponse natively without requiring serialization libraries.
     */
    public static method json(jsonText: string, statusCode: int = 200): HttpResponse<string> {
        let headers = HeaderMap.new()
        headers.set("Content-Type", "application/json; charset=utf-8")
        headers.set("Content-Length", StringUtils.intToString(jsonText.len()))
        return HttpResponse<string>(statusCode, headers, jsonText, jsonText)
    }

    /* -- Doc:{text}
     *
     * -- Description: Creates a text/plain HttpResponse.
     */
    public static method text(textBody: string, statusCode: int = 200): HttpResponse<string> {
        let headers = HeaderMap.new()
        headers.set("Content-Type", "text/plain; charset=utf-8")
        headers.set("Content-Length", StringUtils.intToString(textBody.len()))
        return HttpResponse<string>(statusCode, headers, textBody, textBody)
    }

    /* -- Doc:{format}
     *
     * -- Description: Serializes the complete HTTP response into standard HTTP/1.1 wire protocol format.
     */
    public method format(): string {
        let reason = HttpStatusHelper.reasonPhrase(this.statusCode)
        var out = "HTTP/1.1 " + StringUtils.intToString(this.statusCode) + " " + reason + "\r\n"
        let allHeaders = this.headers.all()
        var i = 0
        while i < allHeaders.len() {
            out = out + allHeaders[i].name + ": " + allHeaders[i].value + "\r\n"
            i = i + 1
        }
        out = out + "\r\n" + this.body
        return out
    }
}
