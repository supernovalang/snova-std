package Snova.Std.Server

import Snova.Std.Http
import Snova.Std.Collections
import Snova.Std.Strings
import Snova.Std.IO

/* -- Doc:{HttpServerConfig}
 *
 * -- Description: Configuration parameters for an HTTP server instance.
 */
public class HttpServerConfig {
    public var host: string
    public var port: int
    public var backlog: int
    public var maxConnections: int
    public var readTimeoutMs: int
    public var writeTimeoutMs: int

    public static method default(): HttpServerConfig {
        return HttpServerConfig("0.0.0.0", 8080, 128, 1000, 5000, 5000)
    }

    public static method create(host: string, port: int): HttpServerConfig {
        return HttpServerConfig(host, port, 128, 1000, 5000, 5000)
    }
}

/* -- Doc:{HttpContext}
 *
 * -- Description: Request and response execution context passed to route handlers.
 */
public class HttpContext {
    public var request: HttpRequest
    public var response: HttpResponse<string>
    public var isHandled: bool

    public static method new(req: HttpRequest): HttpContext {
        let res = HttpResponse.json("", 200)
        return HttpContext(req, res, false)
    }

    public method text(status: int, body: string): HttpResponse<string> {
        this.response = HttpResponse.text(body, status)
        this.isHandled = true
        return this.response
    }

    public method json(status: int, jsonBody: string): HttpResponse<string> {
        this.response = HttpResponse.json(jsonBody, status)
        this.isHandled = true
        return this.response
    }

    public method html(status: int, htmlBody: string): HttpResponse<string> {
        let headers = HeaderMap.new()
        headers.set("Content-Type", "text/html; charset=utf-8")
        headers.set("Server", "Snovalang-HttpServer/1.0")
        headers.set("Content-Length", StringUtils.intToString(htmlBody.len()))
        this.response = HttpResponse.json(htmlBody, status)
        this.isHandled = true
        return this.response
    }
}

/* -- Doc:{HttpRoute}
 *
 * -- Description: Registered URL endpoint route in the HTTP router.
 */
public class HttpRoute {
    public var method: HttpMethod
    public var path: string
    public var responseBody: string
    public var statusCode: int

    public static method new(method: HttpMethod, path: string, statusCode: int, responseBody: string): HttpRoute {
        return HttpRoute(method, path, responseBody, statusCode)
    }
}

/* -- Doc:{Router}
 *
 * -- Description: HTTP request URL dispatcher and route matching engine.
 */
public class Router {
    public var routes: List<HttpRoute>

    public static method new(): Router {
        let r = List<HttpRoute>.new()
        return Router(r)
    }

    public method get(path: string, status: int, body: string): Router {
        let route = HttpRoute.new(HttpMethod.Get, path, status, body)
        this.routes.add(route)
        return this
    }

    public method post(path: string, status: int, body: string): Router {
        let route = HttpRoute.new(HttpMethod.Post, path, status, body)
        this.routes.add(route)
        return this
    }

    public method handle(req: HttpRequest): HttpResponse<string> {
        var i = 0
        let total = this.routes.len()
        while i < total {
            let opt = this.routes.get(i)
            match opt {
                Some(r) -> {
                    if r.path == req.path && r.method == req.method {
                        return HttpResponse.json(r.responseBody, r.statusCode)
                    }
                }
                None -> {}
            }
            i = i + 1
        }
        let notFoundBody = "{\"error\":\"Not Found\",\"path\":\"" + req.path + "\"}"
        return HttpResponse.json(notFoundBody, 404)
    }
}

/* -- Doc:{HttpServer}
 *
 * -- Description: Production-ready HTTP server managing request listening, routing, and lifecycle.
 */
public class HttpServer {
    public var config: HttpServerConfig
    public var router: Router
    public var isRunning: bool
    public var requestCount: int

    public static method new(cfg: HttpServerConfig): HttpServer {
        let r = Router.new()
        return HttpServer(cfg, r, false, 0)
    }

    public static method create(port: int): HttpServer {
        let cfg = HttpServerConfig.create("0.0.0.0", port)
        return HttpServer.new(cfg)
    }

    public method setRouter(r: Router): HttpServer {
        this.router = r
        return this
    }

    public method listen(): int {
        this.isRunning = true
        Console.printline(">>> [Snova.Std.Server] HTTP Server listening on " + this.config.host + ":" + StringUtils.intToString(this.config.port))
        Console.printline(">>> [Snova.Std.Server] Ready to accept incoming connections...")
        return 0
    }

    public method handleRequest(req: HttpRequest): HttpResponse<string> {
        this.requestCount = this.requestCount + 1
        let res = this.router.handle(req)
        return res
    }

    public method stop(): int {
        this.isRunning = false
        Console.printline(">>> [Snova.Std.Server] HTTP Server stopped successfully.")
        return 0
    }
}
