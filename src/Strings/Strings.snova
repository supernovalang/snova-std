package Snova.Std.Strings

import Snova.Std.Collections

/* -- Doc:{StringUtils}
 *
 * -- Description: Comprehensive string manipulation and formatting utilities in pure Snovalang.
 */
public class StringUtils {
    public static method digitValue(c: string): Option<int> {
        if c == "0" { return Some(0) }
        if c == "1" { return Some(1) }
        if c == "2" { return Some(2) }
        if c == "3" { return Some(3) }
        if c == "4" { return Some(4) }
        if c == "5" { return Some(5) }
        if c == "6" { return Some(6) }
        if c == "7" { return Some(7) }
        if c == "8" { return Some(8) }
        if c == "9" { return Some(9) }
        return None
    }

    public static method parseInt(s: string): Option<int> {
        let trimmed = s.trim()
        if trimmed.isEmpty() {
            return None
        }
        var isNegative = false
        var startIdx = 0
        let firstChar = trimmed.substring(0, 1)
        if firstChar == "-" {
            isNegative = true
            startIdx = 1
        } else if firstChar == "+" {
            startIdx = 1
        }

        var result = 0
        var i = startIdx
        let total = trimmed.len()
        while i < total {
            let c = trimmed.substring(i, i + 1)
            let dOpt = StringUtils.digitValue(c)
            match dOpt {
                Some(d) -> {
                    result = result * 10 + d
                }
                None -> {
                    return None
                }
            }
            i = i + 1
        }

        if isNegative {
            return Some(0 - result)
        }
        return Some(result)
    }

    public static method intToString(val: int): string {
        if val == 0 {
            return "0"
        }
        var n = val
        var isNegative = false
        if n < 0 {
            isNegative = true
            n = 0 - n
        }
        var digits = ""
        while n > 0 {
            let rem = n % 10
            var c = "0"
            if rem == 1 { c = "1" }
            if rem == 2 { c = "2" }
            if rem == 3 { c = "3" }
            if rem == 4 { c = "4" }
            if rem == 5 { c = "5" }
            if rem == 6 { c = "6" }
            if rem == 7 { c = "7" }
            if rem == 8 { c = "8" }
            if rem == 9 { c = "9" }
            digits = c + digits
            n = n / 10
        }
        if isNegative {
            return "-" + digits
        }
        return digits
    }

    public static method contains(source: string, search: string): bool {
        return source.indexOf(search) >= 0
    }

    public static method startsWith(source: string, prefix: string): bool {
        if prefix.len() > source.len() {
            return false
        }
        return source.substring(0, prefix.len()) == prefix
    }

    public static method endsWith(source: string, suffix: string): bool {
        let slen = source.len()
        let suflen = suffix.len()
        if suflen > slen {
            return false
        }
        return source.substring(slen - suflen, slen) == suffix
    }

    public static method split(source: string, delimiter: string): Array<string> {
        var result: Array<string> = []
        if delimiter.isEmpty() {
            var i = 0
            while i < source.len() {
                result.push(source.substring(i, i + 1))
                i = i + 1
            }
            return result
        }

        var cur = source
        while true {
            let idx = cur.indexOf(delimiter)
            if idx < 0 {
                result.push(cur)
                break
            }
            result.push(cur.substring(0, idx))
            cur = cur.substring(idx + delimiter.len(), cur.len())
        }
        return result
    }

    public static method join(parts: Array<string>, delimiter: string): string {
        var out = ""
        var i = 0
        let total = parts.len()
        while i < total {
            out = out + parts[i]
            if i + 1 < total {
                out = out + delimiter
            }
            i = i + 1
        }
        return out
    }

    public static method repeat(s: string, count: int): string {
        var out = ""
        var i = 0
        while i < count {
            out = out + s
            i = i + 1
        }
        return out
    }
}

public class StringBuilder {
    private var buffer: Array<string>
    private var size: int

    public static method new(): StringBuilder {
        let empty: Array<string> = []
        return StringBuilder(empty, 0)
    }

    public method append(text: string): int {
        this.buffer.push(text)
        this.size = this.size + text.len()
        return this.size
    }

    public method appendLine(text: string): int {
        this.append(text)
        this.append("\n")
        return this.size
    }

    public method len(): int {
        return this.size
    }

    public method clear(): int {
        let empty: Array<string> = []
        this.buffer = empty
        this.size = 0
        return 0
    }

    public method toString(): string {
        return StringUtils.join(this.buffer, "")
    }
}
