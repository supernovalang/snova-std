package Snova.Std.Strings

// ── Funções Puras de Parsing e Conversão em Snovalang ───────────────────────

public class StringUtils {
    // Converte um caractere numérico em seu valor inteiro ('0' -> 0, etc.)
    public static method digitValue(c: string): Option<int> {
        if c == "0" { return Some(0) }
        if c == "1" { return Some(1) }
        if c == "2" { return Some(2) }
        if c == "3" { return Some(3) }
        if c == "4" { return Some(4) }
        if c == "5" { return Some(5) }
        if c == "6" { return Some(6) }
        if c == "7" { return Some(7) }
        if c == "8" { return Some(8) }
        if c == "9" { return Some(9) }
        return None
    }

    // Parser puro de string para inteiro em Snovalang
    public static method parseInt(s: string): Option<int> {
        let trimmed = s.trim()
        if trimmed.len() == 0 {
            return None
        }
        var isNegative = false
        var startIdx = 0
        let firstOpt = trimmed.charAt(0)
        match firstOpt {
            Some(firstChar) -> {
                if firstChar == "-" {
                    isNegative = true
                    startIdx = 1
                } else if firstChar == "+" {
                    startIdx = 1
                }
            }
            None -> return None
        }

        var result = 0
        var i = startIdx
        while i < trimmed.len() {
            let optC = trimmed.charAt(i)
            match optC {
                Some(c) -> {
                    let dOpt = StringUtils.digitValue(c)
                    match dOpt {
                        Some(d) -> {
                            result = result * 10 + d
                        }
                        None -> return None
                    }
                }
                None -> return None
            }
            i = i + 1
        }

        if isNegative {
            return Some(0 - result)
        }
        return Some(result)
    }

    // Converte inteiro para string em Snovalang puro
    public static method intToString(n: int): string {
        if n == 0 {
            return "0"
        }
        var isNegative = false
        var val = n
        if val < 0 {
            isNegative = true
            val = 0 - val
        }

        var digits = ""
        while val > 0 {
            let rem = val % 10
            var c = "0"
            if rem == 1 { c = "1" }
            else if rem == 2 { c = "2" }
            else if rem == 3 { c = "3" }
            else if rem == 4 { c = "4" }
            else if rem == 5 { c = "5" }
            else if rem == 6 { c = "6" }
            else if rem == 7 { c = "7" }
            else if rem == 8 { c = "8" }
            else if rem == 9 { c = "9" }

            digits = c + digits
            val = val / 10
        }

        if isNegative {
            return "-" + digits
        }
        return digits
    }

    // Divide string por um delimitador em Snovalang puro
    public static method split(text: string, delimiter: string): Array<string> {
        let result: Array<string> = []
        if text.len() == 0 {
            return result
        }
        if delimiter.len() == 0 {
            var i = 0
            while i < text.len() {
                let opt = text.charAt(i)
                match opt {
                    Some(c) -> result.push(c)
                    None -> break
                }
                i = i + 1
            }
            return result
        }

        var current = ""
        var i = 0
        while i < text.len() {
            let opt = text.charAt(i)
            match opt {
                Some(c) -> {
                    if c == delimiter {
                        result.push(current)
                        current = ""
                    } else {
                        current = current + c
                    }
                }
                None -> break
            }
            i = i + 1
        }
        result.push(current)
        return result
    }

    // Junta elementos de um array com delimitador
    public static method join(items: Array<string>, delimiter: string): string {
        var out = ""
        var i = 0
        while i < items.len() {
            if i > 0 {
                out = out + delimiter
            }
            out = out + items[i]
            i = i + 1
        }
        return out
    }
}

// ── Construtor de Strings (StringBuilder) em Snovalang Puro ─────────────────

public class StringBuilder {
    private var buffer: Array<string>
    private var size: int

    public static method new(): StringBuilder {
        let sb = StringBuilder()
        sb.buffer = []
        sb.size = 0
        return sb
    }

    public method append(text: string): int {
        this.buffer.push(text)
        this.size = this.size + text.len()
        return this.size
    }

    public method appendLine(text: string): int {
        this.append(text)
        this.append("\n")
        return this.size
    }

    public method len(): int {
        return this.size
    }

    public method clear(): int {
        this.buffer = []
        this.size = 0
        return 0
    }

    public method toString(): string {
        return StringUtils.join(this.buffer, "")
    }
}
