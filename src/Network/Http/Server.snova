package Snova.Std.Network.Http

import Snova.Std.Network
import Snova.Std.Network.Tcp
import Snova.Std.Collections
import Snova.Std.Strings
import Snova.Std.IO

/* -- Doc:{HttpServerConfig}
 *
 * -- Description: Configuration parameters for an HTTP server instance.
 *   Wraps `NetworkConfig` instead of duplicating fields (DRY principle).
 *   Extends the shared base with HTTP-specific options (workerCount).
 */
public class HttpServerConfig {
    public var network: NetworkConfig
    public var workerCount: int

    /* -- Doc:{default}
     *
     * -- Description: Returns a sensible HTTP server default configuration.
     */
    public static method default(): HttpServerConfig {
        return HttpServerConfig(NetworkConfig.default(), 4)
    }

    /* -- Doc:{create}
     *
     * -- Description: Creates a configuration bound to the specified host and port.
     */
    public static method create(host: string, port: int, workers: int = 4): HttpServerConfig {
        return HttpServerConfig(NetworkConfig.create(host, port), workers)
    }

    /* -- Doc:{host}
     *
     * -- Description: Convenience accessor for the bound host name.
     */
    public method host(): string {
        return this.network.host
    }

    /* -- Doc:{port}
     *
     * -- Description: Convenience accessor for the bound port number.
     */
    public method port(): int {
        return this.network.port
    }
}

/* -- Doc:{IContext}
 *
 * -- Description: Base abstraction interface for polymorphic execution contexts across all Snovalang libraries.
 */
public interface IContext {
    method getId(): string
    method set(key: string, value: string): int
    method get(key: string): Option<string>
    method has(key: string): bool
    method summary(): string
}

/* -- Doc:{HttpContext}
 *
 * -- Description: Real-time request and response execution context passed through route handlers and workers.
 *   Stores application context, attributes, metadata, and handles lifecycle throughout the invocation.
 */
public class HttpContext : IContext {
    public var id: string
    public var request: HttpRequest
    public var response: HttpResponse<string>
    public var attributes: Map<string, string>
    public var metadata: Map<string, string>
    public var workerId: int
    public var isHandled: bool

    public static method new(req: HttpRequest): HttpContext {
        let res = HttpResponse<string>.json("", 200)
        let attrs: Map<string, string> = Map<string, string>.new()
        let meta: Map<string, string> = Map<string, string>.new()
        meta.put("path", req.path)
        meta.put("method", HttpStatusHelper.methodToString(req.method))
        return HttpContext("req_default", req, res, attrs, meta, 0, false)
    }

    public static method create(req: HttpRequest, id: string = "req_1", workerId: int = 0): HttpContext {
        let res = HttpResponse<string>.json("", 200)
        let attrs: Map<string, string> = Map<string, string>.new()
        let meta: Map<string, string> = Map<string, string>.new()
        meta.put("path", req.path)
        meta.put("method", HttpStatusHelper.methodToString(req.method))
        meta.put("workerId", StringUtils.intToString(workerId))
        return HttpContext(id, req, res, attrs, meta, workerId, false)
    }

    public method set(key: string, value: string): int {
        return this.attributes.put(key, value)
    }

    public method get(key: string): Option<string> {
        return this.attributes.get(key)
    }

    public method has(key: string): bool {
        return this.attributes.has(key)
    }

    public method setAttribute(key: string, value: string): int {
        return this.set(key, value)
    }

    public method getAttribute(key: string): Option<string> {
        return this.get(key)
    }

    public method getString(key: string, defaultVal: string = ""): string {
        let opt = this.get(key)
        match opt {
            Some(v) -> { return v }
            None -> { return defaultVal }
        }
    }

    public method setMetadata(key: string, value: string): int {
        return this.metadata.put(key, value)
    }

    public method getMetadata(key: string): Option<string> {
        return this.metadata.get(key)
    }

    public method getMetadataString(key: string, defaultVal: string = ""): string {
        let opt = this.getMetadata(key)
        match opt {
            Some(v) -> { return v }
            None -> { return defaultVal }
        }
    }

    public method setWorkerId(id: int): int {
        this.workerId = id
        this.metadata.put("workerId", StringUtils.intToString(id))
        return 0
    }

    public method getWorkerId(): int {
        return this.workerId
    }

    public method getId(): string {
        return this.id
    }

    public method setId(id: string): int {
        this.id = id
        return 0
    }

    public method text(status: int, body: string): HttpResponse<string> {
        this.response = HttpResponse<string>.text(body, status)
        this.isHandled = true
        return this.response
    }

    public method json(status: int, jsonBody: string): HttpResponse<string> {
        this.response = HttpResponse<string>.json(jsonBody, status)
        this.isHandled = true
        return this.response
    }

    public method html(status: int, htmlBody: string): HttpResponse<string> {
        this.response = HttpResponse<string>.html(htmlBody, status)
        this.isHandled = true
        return this.response
    }

    public method notFound(): HttpResponse<string> {
        let notFoundBody = "{\"error\":\"Not Found\",\"path\":\"" + this.request.path + "\"}"
        this.response = HttpResponse<string>.json(notFoundBody, 404)
        this.isHandled = true
        return this.response
    }

    public method summary(): string {
        return "[HttpContext id=" + this.id + " path=" + this.request.path + " worker=" + StringUtils.intToString(this.workerId) + " handled=" + StringUtils.intToString(this.attributes.len()) + " attrs]"
    }
}

/* -- Doc:{RuntimeContext}
 *
 * -- Description: Dedicated runtime context storage class that inherits from HttpContext
 *   and preserves the invocation context across threads, workers, and pulsar functions.
 */
public class RuntimeContext : HttpContext {
    public var id: string
    public var httpContext: HttpContext
    public var globalAttributes: Map<string, string>
    public var isAlive: bool
    public var executionPhase: string

    public static method new(httpContext: HttpContext): RuntimeContext {
        let globals: Map<string, string> = Map<string, string>.new()
        return RuntimeContext(httpContext.id, httpContext, globals, true, "runtime")
    }

    public static method create(req: HttpRequest, contextId: string = "ctx_1", workerId: int = 0): RuntimeContext {
        let ctx = HttpContext.create(req, contextId, workerId)
        let globals: Map<string, string> = Map<string, string>.new()
        return RuntimeContext(contextId, ctx, globals, true, "runtime")
    }

    public method getContext(): HttpContext {
        return this.httpContext
    }

    public method set(key: string, value: string): int {
        this.globalAttributes.put(key, value)
        return this.httpContext.set(key, value)
    }

    public method get(key: string): Option<string> {
        let opt = this.httpContext.get(key)
        match opt {
            Some(v) -> { return Some(v) }
            None -> { return this.globalAttributes.get(key) }
        }
    }

    public method getString(key: string, defaultVal: string = ""): string {
        let opt = this.get(key)
        match opt {
            Some(v) -> { return v }
            None -> { return defaultVal }
        }
    }

    public method has(key: string): bool {
        if this.httpContext.has(key) {
            return true
        }
        return this.globalAttributes.has(key)
    }

    public method setMetadata(key: string, value: string): int {
        return this.httpContext.setMetadata(key, value)
    }

    public method getMetadata(key: string): Option<string> {
        return this.httpContext.getMetadata(key)
    }

    public method getMetadataString(key: string, defaultVal: string = ""): string {
        return this.httpContext.getMetadataString(key, defaultVal)
    }

    public method getResponse(): HttpResponse<string> {
        return this.httpContext.response
    }

    public method setResponse(res: HttpResponse<string>): int {
        this.httpContext.response = res
        this.httpContext.isHandled = true
        return 0
    }

    public method json(status: int, body: string): HttpResponse<string> {
        return this.httpContext.json(status, body)
    }

    public method text(status: int, body: string): HttpResponse<string> {
        return this.httpContext.text(status, body)
    }

    public method html(status: int, body: string): HttpResponse<string> {
        return this.httpContext.html(status, body)
    }

    public method notFound(): HttpResponse<string> {
        return this.httpContext.notFound()
    }

    public method isFinished(): bool {
        if this.isAlive {
            return false
        }
        return true
    }

    public method summary(): string {
        var statusStr = "alive"
        if this.isAlive == false {
            statusStr = "finished"
        }
        return "[RuntimeContext id=" + this.id + " phase=" + this.executionPhase + " status=" + statusStr + " http=" + this.httpContext.summary() + "]"
    }

    public method finish(): int {
        this.isAlive = false
        return 0
    }
}

/* -- Doc:{CompileContext}
 *
 * -- Description: Compilation and AST static analysis context abstraction.
 */
public class CompileContext : IContext {
    public var id: string
    public var sourceFile: string
    public var targetPackage: string
    public var diagCount: int
    public var attributes: Map<string, string>

    public static method new(sourceFile: string, targetPackage: string = "main"): CompileContext {
        let attrs: Map<string, string> = Map<string, string>.new()
        return CompileContext(sourceFile, sourceFile, targetPackage, 0, attrs)
    }

    public method getId(): string {
        return this.id
    }

    public method set(key: string, value: string): int {
        return this.attributes.put(key, value)
    }

    public method get(key: string): Option<string> {
        return this.attributes.get(key)
    }

    public method has(key: string): bool {
        return this.attributes.has(key)
    }

    public method recordDiag(): int {
        this.diagCount = this.diagCount + 1
        return this.diagCount
    }

    public method summary(): string {
        return "[CompileContext source=" + this.sourceFile + " package=" + this.targetPackage + " diags=" + StringUtils.intToString(this.diagCount) + "]"
    }
}

/* -- Doc:{ErrorContext}
 *
 * -- Description: Polymorphic error tracking context abstraction.
 */
public class ErrorContext : IContext {
    public var id: string
    public var errorCode: int
    public var errorMessage: string
    public var errorType: string
    public var timestamp: string
    public var isHandled: bool
    public var details: Map<string, string>

    public static method new(errorCode: int, errorMessage: string, errorType: string = "Error", timestamp: string = "0"): ErrorContext {
        let d: Map<string, string> = Map<string, string>.new()
        return ErrorContext("err_" + StringUtils.intToString(errorCode), errorCode, errorMessage, errorType, timestamp, false, d)
    }

    public static method create(code: int, msg: string, errType: string = "Error"): ErrorContext {
        let d: Map<string, string> = Map<string, string>.new()
        return ErrorContext("err_" + StringUtils.intToString(code), code, msg, errType, "0", false, d)
    }

    public method getId(): string {
        return this.id
    }

    public method set(key: string, value: string): int {
        return this.details.put(key, value)
    }

    public method get(key: string): Option<string> {
        return this.details.get(key)
    }

    public method has(key: string): bool {
        return this.details.has(key)
    }

    public method markHandled(): int {
        this.isHandled = true
        return 0
    }

    public method summary(): string {
        return "[ErrorContext code=" + StringUtils.intToString(this.errorCode) + " type=" + this.errorType + " message=" + this.errorMessage + "]"
    }
}

/* -- Doc:{ExceptionContext}
 *
 * -- Description: Exception context inheriting from ErrorContext.
 */
public class ExceptionContext : ErrorContext {
    public var id: string
    public var errorCode: int
    public var errorMessage: string
    public var errorType: string
    public var timestamp: string
    public var isHandled: bool
    public var details: Map<string, string>
    public var exceptionName: string
    public var stackTrace: string

    public static method new(code: int, msg: string, name: string = "Exception", stack: string = ""): ExceptionContext {
        let d: Map<string, string> = Map<string, string>.new()
        return ExceptionContext("ex_" + StringUtils.intToString(code), code, msg, "Exception", "0", false, d, name, stack)
    }

    public static method create(msg: string, name: string = "RuntimeException"): ExceptionContext {
        let d: Map<string, string> = Map<string, string>.new()
        return ExceptionContext("ex_500", 500, msg, "Exception", "0", false, d, name, "")
    }

    public method summary(): string {
        return "[ExceptionContext name=" + this.exceptionName + " code=" + StringUtils.intToString(this.errorCode) + " message=" + this.errorMessage + "]"
    }
}

/* -- Doc:{ContextRegistry}
 *
 * -- Description: Internal registry for storing and resolving active context and exceptions.
 */
public class ContextRegistry {
    public static var currentError: Option<ErrorContext> = None

    public static method getActiveError(targetType: string = ""): Option<ErrorContext> {
        return ContextRegistry.currentError
    }

    public static method registerError(err: ErrorContext): int {
        ContextRegistry.currentError = Some(err)
        return 0
    }

    public static method registerException(ex: ExceptionContext): int {
        let err = ErrorContext.create(ex.errorCode, ex.errorMessage, ex.exceptionName)
        ContextRegistry.currentError = Some(err)
        return 0
    }

    public static method clear(): int {
        ContextRegistry.currentError = None
        return 0
    }
}

/* -- Doc:{Context}
 *
 * -- Description: Unified polymorphic library Context inheriting from RuntimeContext (which inherits from HttpContext),
 *   and providing polymorphic access to CompileContext, ErrorContext, and ExceptionContext.
 */
public class Context : RuntimeContext {
    public var id: string
    public var httpContext: HttpContext
    public var globalAttributes: Map<string, string>
    public var isAlive: bool
    public var executionPhase: string
    public var compileContext: Option<CompileContext>
    public var errorContext: Option<ErrorContext>
    public var exceptionContext: Option<ExceptionContext>

    public static method new(httpContext: HttpContext): Context {
        let globals: Map<string, string> = Map<string, string>.new()
        let noCompile: Option<CompileContext> = None
        let noErr: Option<ErrorContext> = None
        let noEx: Option<ExceptionContext> = None
        return Context(httpContext.id, httpContext, globals, true, "runtime", noCompile, noErr, noEx)
    }

    public static method create(req: HttpRequest, contextId: string = "ctx_1", workerId: int = 0): Context {
        let httpCtx = HttpContext.create(req, contextId, workerId)
        return Context.new(httpCtx)
    }

    public static method get(targetType: string = "ExceptionContext"): Option<ErrorContext> {
        return ContextRegistry.getActiveError(targetType)
    }

    public static method throwException(ex: ExceptionContext): int {
        return ContextRegistry.registerException(ex)
    }

    public static method throwError(code: int, message: string, errorType: string = "Error"): int {
        let err = ErrorContext.create(code, message, errorType)
        return ContextRegistry.registerError(err)
    }

    public static method clearError(): int {
        return ContextRegistry.clear()
    }

    public method getError(): Option<ErrorContext> {
        match this.errorContext {
            Some(e) -> { return Some(e) }
            None -> { return ContextRegistry.getActiveError("ErrorContext") }
        }
    }

    public method getException(): Option<ExceptionContext> {
        return this.exceptionContext
    }

    public method setError(err: ErrorContext): int {
        this.errorContext = Some(err)
        ContextRegistry.registerError(err)
        return 0
    }

    public method setException(ex: ExceptionContext): int {
        this.exceptionContext = Some(ex)
        let err = ErrorContext.create(ex.errorCode, ex.errorMessage, ex.exceptionName)
        this.errorContext = Some(err)
        ContextRegistry.registerException(ex)
        return 0
    }

    public method hasError(): bool {
        match this.errorContext {
            Some(e) -> { return true }
            None -> {
                let active = ContextRegistry.getActiveError("")
                match active {
                    Some(ae) -> { return true }
                    None -> { return false }
                }
            }
        }
    }

    public method raiseError(code: int, message: string, errorType: string = "Error"): int {
        let err = ErrorContext.create(code, message, errorType)
        return this.setError(err)
    }

    public method raiseException(message: string, exceptionName: string = "RuntimeException"): int {
        let ex = ExceptionContext.create(message, exceptionName)
        return this.setException(ex)
    }

    public method setCompileContext(cc: CompileContext): int {
        this.compileContext = Some(cc)
        return 0
    }

    public method getCompileContext(): Option<CompileContext> {
        return this.compileContext
    }

    public method summary(): string {
        var errDesc = "no_error"
        match this.errorContext {
            Some(e) -> { errDesc = e.errorMessage }
            None -> {}
        }
        var aliveStr = "alive"
        if this.isAlive == false {
            aliveStr = "finished"
        }
        return "[Context id=" + this.id + " status=" + aliveStr + " err=" + errDesc + " http=" + this.httpContext.summary() + "]"
    }
}

/* -- Doc:{GlobalExceptionHandler}
 *
 * -- Description: Centralized Global Exception Handler for polymorphic context error intercept and formatting.
 */
public class GlobalExceptionHandler {
    public static method handle(ctx: Context): HttpResponse<string> {
        let errOpt = Context.get("ExceptionContext")
        match errOpt {
            Some(err) -> {
                Console.printline("[GlobalExceptionHandler] Caught unhandled exception: [" + err.errorType + "] " + err.errorMessage)
                let errorBody = "{\"error\":true,\"status\":500,\"message\":\"" + err.errorMessage + "\",\"type\":\"" + err.errorType + "\"}"
                ctx.response = HttpResponse<string>.json(errorBody, 500)
                ctx.isHandled = true
                err.markHandled()
                return ctx.response
            }
            None -> {
                let instErrOpt = ctx.getError()
                match instErrOpt {
                    Some(err) -> {
                        Console.printline("[GlobalExceptionHandler] Caught context exception: [" + err.errorType + "] " + err.errorMessage)
                        let errorBody = "{\"error\":true,\"status\":500,\"message\":\"" + err.errorMessage + "\",\"type\":\"" + err.errorType + "\"}"
                        ctx.response = HttpResponse<string>.json(errorBody, 500)
                        ctx.isHandled = true
                        err.markHandled()
                        return ctx.response
                    }
                    None -> {
                        return ctx.response
                    }
                }
            }
        }
    }

    public static method handleContext(ctx: HttpContext): HttpResponse<string> {
        let errOpt = Context.get("ExceptionContext")
        match errOpt {
            Some(err) -> {
                Console.printline("[GlobalExceptionHandler] Caught unhandled exception on HttpContext: [" + err.errorType + "] " + err.errorMessage)
                let errorBody = "{\"error\":true,\"status\":500,\"message\":\"" + err.errorMessage + "\",\"type\":\"" + err.errorType + "\"}"
                ctx.response = HttpResponse<string>.json(errorBody, 500)
                ctx.isHandled = true
                err.markHandled()
                return ctx.response
            }
            None -> {
                return ctx.response
            }
        }
    }
}

public func type(name: any): string {
    return "ExceptionContext"
}

/* -- Doc:{HttpRoute}
 *
 * -- Description: Registered URL endpoint route in the HTTP router.
 *   Encapsulates path, method, and canned response — an immutable route descriptor.
 */
public class HttpRoute {
    public var method: HttpMethod
    public var path: string
    public var responseBody: string
    public var statusCode: int

    public static method new(method: HttpMethod, path: string, statusCode: int, responseBody: string): HttpRoute {
        return HttpRoute(method, path, responseBody, statusCode)
    }
}

/* -- Doc:{Router}
 *
 * -- Description: HTTP request URL dispatcher and route matching engine.
 *   Implements `IHttpHandler` — so any component expecting a handler can accept a Router,
 *   and a Router can be replaced with any other IHttpHandler without changing caller code
 *   (Liskov Substitution Principle, Dependency Inversion Principle).
 */
public class Router : IHttpHandler {
    public var routes: List<HttpRoute>

    public static method new(): Router {
        let r = List<HttpRoute>.new()
        return Router(r)
    }

    /* -- Doc:{get}
     *
     * -- Description: Registers a GET route and returns the Router for method chaining (fluent API).
     */
    public method get(path: string, status: int, body: string): Router {
        let route = HttpRoute.new(HttpMethod.Get, path, status, body)
        this.routes.add(route)
        return this
    }

    /* -- Doc:{post}
     *
     * -- Description: Registers a POST route and returns the Router for method chaining.
     */
    public method post(path: string, status: int, body: string): Router {
        let route = HttpRoute.new(HttpMethod.Post, path, status, body)
        this.routes.add(route)
        return this
    }

    /* -- Doc:{put}
     *
     * -- Description: Registers a PUT route and returns the Router for method chaining.
     */
    public method put(path: string, status: int, body: string): Router {
        let route = HttpRoute.new(HttpMethod.Put, path, status, body)
        this.routes.add(route)
        return this
    }

    /* -- Doc:{delete}
     *
     * -- Description: Registers a DELETE route and returns the Router for method chaining.
     */
    public method delete(path: string, status: int, body: string): Router {
        let route = HttpRoute.new(HttpMethod.Delete, path, status, body)
        this.routes.add(route)
        return this
    }

    public method handleContext(ctx: HttpContext): HttpResponse<string> {
        var i = 0
        let total = this.routes.len()
        while i < total {
            let opt = this.routes.get(i)
            match opt {
                Some(r) -> {
                    if r.path == ctx.request.path && r.method == ctx.request.method {
                        ctx.setMetadata("route_matched", r.path)
                        ctx.response = HttpResponse<string>.json(r.responseBody, r.statusCode)
                        ctx.isHandled = true
                        return ctx.response
                    }
                }
                None -> {}
            }
            i = i + 1
        }
        ctx.setMetadata("route_matched", "none")
        return ctx.notFound()
    }

    /* IHttpHandler — the single dispatch method every handler must honour */
    public method handle(req: HttpRequest): HttpResponse<string> {
        let ctx = HttpContext.new(req)
        return this.handleContext(ctx)
    }
}

/* -- Doc:{HttpServer}
 *
 * -- Description: Production-ready HTTP server managing request listening, TCP sockets, routing, and pulsar workers.
 *   Depends on `IHttpHandler` rather than `Router` directly (Dependency Inversion Principle): callers
 *   can inject any IHttpHandler implementation including middleware chains or mock handlers.
 *   Implements `ICloseable` for lifecycle consistency.
 */
public class HttpServer : ICloseable {
    public var config: HttpServerConfig
    public var handler: IHttpHandler
    private var running: bool
    public var requestCount: int
    public var tcpListener: TcpListener

    public static method new(cfg: HttpServerConfig): HttpServer {
        let r = Router.new()
        let listener = TcpListener.bindWithBacklog(cfg.host(), cfg.port(), cfg.network.backlog)
        return HttpServer(cfg, r, false, 0, listener)
    }

    public static method create(port: int): HttpServer {
        let cfg = HttpServerConfig.create("0.0.0.0", port, 4)
        return HttpServer.new(cfg)
    }

    /* -- Doc:{setHandler}
     *
     * -- Description: Injects an IHttpHandler (Router, middleware chain, or mock) into this server.
     *   Replaces `setRouter` — accepts any IHttpHandler, not just Router (DIP).
     */
    public method setHandler(h: IHttpHandler): HttpServer {
        this.handler = h
        return this
    }

    /* -- Doc:{setRouter}
     *
     * -- Description: Convenience alias for `setHandler` accepting a concrete Router.
     *   Maintained for backwards compatibility; delegates to setHandler via LSP substitution.
     */
    public method setRouter(r: Router): HttpServer {
        return this.setHandler(r)
    }

    public method isRunning(): bool {
        return this.running
    }

    public method listen(): int {
        this.running = true
        Console.printline(">>> [Snova.Std.Network.Http] HTTP Server listening on " + this.config.host() + ":" + StringUtils.intToString(this.config.port()))
        Console.printline(">>> [Snova.Std.Network.Http] Socket bound successfully via TCP backlog " + StringUtils.intToString(this.config.network.backlog))
        return 0
    }

    public method startWithWorkers(workerCount: int): HttpWorkerPool {
        this.running = true
        let pool = HttpWorkerPool.create(this.config.host(), this.config.port(), workerCount, this.handler)
        pool.start()
        Console.printline(">>> [Snova.Std.Network.Http] HTTP Server running with " + StringUtils.intToString(workerCount) + " pulsar workers.")
        return pool
    }

    public method handleContext(ctx: HttpContext): HttpResponse<string> {
        this.requestCount = this.requestCount + 1
        let methodStr = HttpStatusHelper.methodToString(ctx.request.method)
        pulsar httpServeContext(1, ctx)
        pulsar httpServeRequestContext(1, ctx.id, ctx.request.path, methodStr)
        pulsar httpServeRequest(1, ctx.request.path, methodStr)
        pulsar httpAuditContext(ctx, "server_received", ctx.request.path)
        return this.handler.handle(ctx.request)
    }

    public method handleRequest(req: HttpRequest): HttpResponse<string> {
        let ctx = HttpContext.create(req, "req_srv_" + StringUtils.intToString(this.requestCount + 1), 1)
        return this.handleContext(ctx)
    }

    /* ICloseable */
    public method close(): int {
        this.running = false
        this.tcpListener.close()
        Console.printline(">>> [Snova.Std.Network.Http] HTTP Server stopped successfully.")
        return 0
    }
}
