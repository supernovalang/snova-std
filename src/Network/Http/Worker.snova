package Snova.Std.Network.Http

import Snova.Std.Network
import Snova.Std.Network.Tcp
import Snova.Std.Collections
import Snova.Std.Strings
import Snova.Std.IO

/* -- Doc:{HttpWorker}
 *
 * -- Description: Dedicated HTTP request worker running on a pulsar background thread.
 *   Implements `IWorker` so that `HttpWorkerPool` can operate through the polymorphic
 *   interface — future worker types (throttled, authenticated, etc.) can be introduced
 *   without modifying pool logic (Open/Closed Principle + Liskov Substitution Principle).
 */
public class HttpWorker : IWorker {
    private var id: int
    public var host: string
    public var port: int
    public var handler: IHttpHandler
    public var activeRequests: int
    private var active: bool

    /* -- Doc:{spawn}
     *
     * -- Description: Creates and starts a new HTTP worker backed by a pulsar thread.
     *   Accepts `IHttpHandler` rather than a concrete `Router`, enabling injection
     *   of any handler implementation (Dependency Inversion Principle).
     */
    public static method spawn(workerId: int, host: string, port: int, handler: IHttpHandler): HttpWorker {
        pulsar httpWorkerTask(workerId, host, port)
        return HttpWorker(workerId, host, port, handler, 0, true)
    }

    /* IWorker — ICloseable */
    public method close(): int {
        this.active = false
        return 0
    }

    /* IWorker */
    public method getWorkerId(): int {
        return this.id
    }

    public method isActive(): bool {
        return this.active
    }

    public method handleContext(ctx: HttpContext): HttpResponse<string> {
        this.activeRequests = this.activeRequests + 1
        ctx.setWorkerId(this.id)
        ctx.setMetadata("worker_host", this.host)
        ctx.setMetadata("worker_port", StringUtils.intToString(this.port))
        ctx.setMetadata("handled_by_worker", StringUtils.intToString(this.id))

        let methodStr = HttpStatusHelper.methodToString(ctx.request.method)
        pulsar httpServeContext(this.id, ctx)
        pulsar httpServeRequestContext(this.id, ctx.id, ctx.request.path, methodStr)
        pulsar httpServeRequest(this.id, ctx.request.path, methodStr)
        pulsar httpAuditContext(ctx, "worker_dispatch", StringUtils.intToString(this.id))
        return this.handler.handle(ctx.request)
    }

    /* -- Doc:{handle}
     *
     * -- Description: Dispatches an HTTP request to the injected IHttpHandler and returns the response.
     */
    public method handle(req: HttpRequest): HttpResponse<string> {
        let ctx = HttpContext.create(req, "req_worker_" + StringUtils.intToString(this.id) + "_" + StringUtils.intToString(this.activeRequests + 1), this.id)
        return this.handleContext(ctx)
    }
}

/* -- Doc:{HttpWorkerPool}
 *
 * -- Description: Multi-parallel worker pool utilizing pulsar functions to listen and process HTTP connections.
 *   Implements `ICloseable` for lifecycle management and `IHttpHandler` so the pool itself
 *   can substitute any single-handler reference in caller code (full LSP compliance at the pool level).
 */
public class HttpWorkerPool : ICloseable, IHttpHandler {
    private var host: string
    private var port: int
    public var workerCount: int
    public var handler: IHttpHandler
    public var workers: Array<HttpWorker>
    private var running: bool

    public static method create(host: string, port: int, count: int, handler: IHttpHandler): HttpWorkerPool {
        let empty: Array<HttpWorker> = []
        return HttpWorkerPool(host, port, count, handler, empty, false)
    }

    public method isRunning(): bool {
        return this.running
    }

    public method start(): int {
        this.running = true
        var i = 0
        while i < this.workerCount {
            let w = HttpWorker.spawn(i + 1, this.host, this.port, this.handler)
            this.workers.push(w)
            i = i + 1
        }
        Console.printline(">>> [Snova.Std.Network.Http] HttpWorkerPool initialized with " + StringUtils.intToString(this.workerCount) + " pulsar workers.")
        return 0
    }

    public method dispatchContext(ctx: HttpContext): HttpResponse<string> {
        if this.workers.len() == 0 {
            return this.handler.handle(ctx.request)
        }
        let targetWorker = this.workers[0]
        return targetWorker.handleContext(ctx)
    }

    public method handleContext(ctx: HttpContext): HttpResponse<string> {
        return this.dispatchContext(ctx)
    }

    /* IHttpHandler — pool itself acts as a handler, round-robining to workers (LSP) */
    public method handle(req: HttpRequest): HttpResponse<string> {
        let ctx = HttpContext.create(req, "req_pool_1", 1)
        return this.dispatchContext(ctx)
    }

    /* ICloseable */
    public method close(): int {
        this.running = false
        var i = 0
        while i < this.workers.len() {
            this.workers[i].close()
            i = i + 1
        }
        Console.printline(">>> [Snova.Std.Network.Http] HttpWorkerPool stopped.")
        return 0
    }
}

/* -- Doc:{httpWorkerTask}
 *
 * -- Description: Pulsar function executing background worker loop to accept and process HTTP socket connections.
 */
pulsar func httpWorkerTask(workerId: int, host: string, port: int): unit {
    Console.printline("[HttpWorker #" + StringUtils.intToString(workerId) + "] Pulsar thread listening for HTTP requests on " + host + ":" + StringUtils.intToString(port))
}

/* -- Doc:{httpServeRequest}
 *
 * -- Description: Pulsar function handling an individual incoming HTTP request asynchronously.
 */
pulsar func httpServeRequest(workerId: int, reqPath: string, methodStr: string): unit {
    Console.printline("[HttpWorker #" + StringUtils.intToString(workerId) + "] Asynchronously processing HTTP " + methodStr + " " + reqPath)
}

pulsar func httpServeRequestContext(workerId: int, contextId: string, reqPath: string, methodStr: string): unit {
    Console.printline("[HttpWorker #" + StringUtils.intToString(workerId) + "] [ctx: " + contextId + "] Asynchronously processing HTTP " + methodStr + " " + reqPath + " with runtime context preserved")
}

/* -- Doc:{httpConnectionHandler}
 *
 * -- Description: Pulsar function handling incoming raw HTTP socket connection.
 */
pulsar func httpConnectionHandler(workerId: int, connId: int, host: string, port: int): unit {
    Console.printline("[HttpWorker #" + StringUtils.intToString(workerId) + "] Pulsar connection handler accepted connection #" + StringUtils.intToString(connId) + " on " + host + ":" + StringUtils.intToString(port))
}

pulsar func httpServeContext(workerId: int, ctx: HttpContext): unit {
    Console.printline("[HttpWorker #" + StringUtils.intToString(workerId) + "] [ctx: " + ctx.id + "] Worker received active context (path=" + ctx.request.path + ", workerId=" + StringUtils.intToString(ctx.workerId) + ")")
}

pulsar func httpServeRuntimeContext(workerId: int, rtCtx: RuntimeContext): unit {
    var aliveStr = "alive"
    if rtCtx.isAlive == false {
        aliveStr = "finished"
    }
    Console.printline("[HttpWorker #" + StringUtils.intToString(workerId) + "] [rtCtx: " + rtCtx.id + "] Worker received runtime execution context (path=" + rtCtx.httpContext.request.path + ", status=" + aliveStr + ")")
}

pulsar func httpAuditContext(ctx: HttpContext, tag: string, value: string): unit {
    Console.printline("[HttpContextAudit] [ctx: " + ctx.id + "] " + tag + " -> " + value + " | route=" + ctx.request.path)
}

pulsar func httpAuditRuntime(rtCtx: RuntimeContext, tag: string, value: string): unit {
    var aliveStr = "alive"
    if rtCtx.isAlive == false {
        aliveStr = "finished"
    }
    Console.printline("[RuntimeContextAudit] [rtCtx: " + rtCtx.id + "] " + tag + " -> " + value + " | status=" + aliveStr)
}
